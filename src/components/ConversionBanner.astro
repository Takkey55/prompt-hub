---
import { Database, CheckCircle2, ArrowRight, Sparkles, Terminal, BookOpen, Crown } from 'lucide-astro';

interface Props {
  noteUrl?: string;
  category?: string;
}

const {
  noteUrl = "https://note.com/prompt_hub_official",
} = Astro.props;
---

<div class="relative group overflow-hidden rounded-3xl bg-slate-900/90 border border-slate-800 p-1 shadow-2xl transition-all duration-300 hover:border-brand-500/50 hover:shadow-brand-500/10">
  <!-- Glowing gradient border effect -->
  <div class="absolute inset-0 bg-gradient-to-r from-brand-500/20 via-purple-500/20 to-sky-500/20 rounded-3xl opacity-50 group-hover:opacity-100 transition-opacity blur-sm pointer-events-none"></div>

  <div class="relative z-10 rounded-[22px] bg-slate-950/90 p-6 md:p-10 backdrop-blur-xl">
    <!-- Top badge bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-6 border-b border-slate-800/80">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gradient-to-r from-amber-500/10 to-brand-500/10 text-amber-300 border border-amber-500/30">
        <Crown class="w-3.5 h-3.5 text-amber-400" />
        <span>オールインワン完全版メンバーシップ & Notion DB</span>
      </div>

      <!-- Pricing / Offer badge -->
      <div class="flex items-center gap-2 text-xs">
        <span class="px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 font-semibold">
          初月無料トライアルあり
        </span>
        <span class="text-slate-400">または</span>
        <span class="px-2.5 py-1 rounded-md bg-slate-900 text-slate-300 border border-slate-700 font-semibold">
          買い切り完全版
        </span>
      </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-4">
        <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-snug">
          実務を即座に自動化する<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 via-sky-200 to-indigo-300">
            『プロンプト＆スクリプト完全版データベース』
          </span>
        </h3>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          WEB制作・マーケティング・SNS運用の全現場で検証済みの実戦コード・プロンプト・自動化ワークフローを1つのNotionデータベースに集約。コピペで即日業務効率を10倍に引き上げます。
        </p>

        <!-- Feature Points -->
        <ul class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-300">
          <li class="flex items-start gap-2.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" />
            <span><strong class="text-white font-medium">全業種・全自動化スクリプトを網羅したNotion DB</strong>（毎週最新プロンプトを自動更新・追加）</span>
          </li>
          <li class="flex items-start gap-2.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" />
            <span><strong class="text-white font-medium">コピペ不要・Claude Code設定ファイル</strong>（<code class="text-brand-300 font-mono text-[11px] bg-slate-900 px-1 py-0.5 rounded border border-slate-800">.cursorrules</code> / <code class="text-brand-300 font-mono text-[11px] bg-slate-900 px-1 py-0.5 rounded border border-slate-800">CLAUDE.md</code>）同梱</span>
          </li>
          <li class="flex items-start gap-2.5">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" />
            <span><strong class="text-white font-medium">メンバー限定のプロンプト設計思考</strong>＆最新モデル（Claude 3.7 / o3-mini）先行対応ノウハウ</span>
          </li>
        </ul>
      </div>

      <!-- Action Box -->
      <div class="lg:col-span-5 flex flex-col items-center justify-center p-6 rounded-2xl bg-slate-900/80 border border-slate-800 text-center space-y-4 shadow-inner">
        <div class="space-y-1">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-brand-400">All-in-One Prompt Database</div>
          <div class="text-2xl font-black text-white">月額 ¥980〜 <span class="text-xs font-normal text-slate-400">/ 月</span></div>
          <div class="text-[11px] text-slate-400">※いつでもワンクリックで解約可能</div>
        </div>

        <a
          href={noteUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="cta-note"
          class="inline-flex w-full items-center justify-center gap-2 px-6 py-4 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-brand-300 via-sky-200 to-indigo-200 hover:from-white hover:to-brand-100 shadow-xl shadow-brand-500/20 transition-all duration-200 hover:scale-[1.02] active:scale-95 group/btn"
        >
          <Database class="w-4 h-4 text-slate-900" />
          <span>完全版データベースの詳細を見る（note）</span>
          <ArrowRight class="w-4 h-4 text-slate-900 group-hover/btn:translate-x-1 transition-transform" />
        </a>

        <div class="flex items-center justify-center gap-3 text-[11px] text-slate-400">
          <span class="flex items-center gap-1">
            <Sparkles class="w-3 h-3 text-amber-400" /> 即時アクセス可能
          </span>
          <span>•</span>
          <span class="flex items-center gap-1">
            <BookOpen class="w-3 h-3 text-brand-400" /> Notion複製リンク付
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
